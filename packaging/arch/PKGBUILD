pkgname=keywrld
pkgver=0.1.8
pkgrel=1
pkgdesc='A keyboard-shaped Hyprland system shortcut overlay'
arch=('x86_64')
url='https://github.com/mks-m/keywrld'
license=('MIT' 'ISC' 'CC0-1.0')
depends=('cairo' 'glib2' 'glibc' 'gtk4' 'gtk4-layer-shell>=1.3.0' 'hyprland' 'libgcc' 'pango')
makedepends=('cargo' 'pkgconf')
optdepends=('omarchy: Lua binding supplements and desktop theme integration')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Replace with the published archive's SHA-256; do not use SKIP for releases.
sha256sums=('8de67cd0625c4e30007aaa52f5ecbdffda351e8c7faab5990eeb2527ec824462')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/keywrld "$pkgdir/usr/bin/keywrld"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 assets/icons/THIRD_PARTY_NOTICES.md \
    "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
